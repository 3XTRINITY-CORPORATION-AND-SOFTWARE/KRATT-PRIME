# Local-only KRATT host runtime. Binds to loopback by default.
KRATT_HOST=127.0.0.1
KRATT_PORT=4317
KRATT_LOG_LEVEL=info
KRATT_RUNTIME_MODE=local
# Optional absolute local journal path for GET /evidence and GET /evidence/verify.
# No default journal is created by the read-only API.
# KRATT_JOURNAL_PATH=C:/kratt-data/evidence.journal
# Optional absolute local worker lease journal for GET /leases/status.
# The read-only operator endpoint exposes counts only, never task or owner identifiers.
# KRATT_LEASE_JOURNAL_PATH=C:/kratt-data/worker-leases.journal


